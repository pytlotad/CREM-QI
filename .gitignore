# Build artifacts.  Both executables are produced by `make` and must not be
# tracked: every rebuild would otherwise add a ~400 kB blob to the history.
/crem_interactions
/crem_interactions_validation
/crem_interactions_reproducible
/crem_interactions_validation_reproducible
/crem_interactions_validation_asan
/crem_interactions_validation_ubsan
/crem_interactions_asan
/crem_interactions_ubsan
# Legacy names (symlinks made by the Makefile so that the `./positronium`
# commands recorded in audits/ keep working after the rename to CREM-QI).
/positronium
/positronium_validation
/positronium_reproducible
/positronium_validation_reproducible
/positronium_validation_asan
/positronium_validation_ubsan
/positronium_asan
/positronium_ubsan
*.o
*.d

# Editor and OS noise
*~
*.swp
.DS_Store

# Temporary files written by the PDF exporter and the reference archive.
# They are normally renamed over their destination, but a crashed run can
# leave one behind.
.*.tmp_*
distributions/.*.tmp_*.pdf

# Bytecode cache of the reference validator in tools/.  Written whenever the
# module is imported rather than run as a script.
__pycache__/
*.pyc

# Claude Code: the shared permission list is tracked, the per-machine
# overrides in settings.local.json are not.
.claude/settings.local.json
